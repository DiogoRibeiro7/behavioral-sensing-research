# The frozen v0.3 artifacts carry recorded SHA-256 digests computed on LF
# content. Letting git rewrite their line endings on checkout would make those
# digests verify or fail depending on the platform rather than on the content.
artifacts/v03/*.json text eol=lf

# The Phase 1 artifacts are read back and verified the same way: the frozen
# household splits by their recorded digest, the published record by tests.
artifacts/phase1/*.json text eol=lf

# The frozen Phase 3 protocol is verified the same way, by its recorded digest.
artifacts/phase3/*.json text eol=lf

# Figures are drawn from their published records, and each SVG carries the
# digest of the data it plots. Matplotlib writes path data with trailing
# spaces, so the files are not diffed as text.
docs/figures/*.svg text eol=lf -diff
